instance Eq ((T a)) where { == = equations { (T) (T) -> True; }; }
instance Ord ((T a)) where { compare = equations { (T) (T) -> EQ; }; }
instance Show ((T a)) where { show = equations { value -> _showsPrec 0 value; }; _showsPrec = equations { p (T) -> "T"; }; }
