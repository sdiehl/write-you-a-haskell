// adapted from sdiehl/compiler-crates/lalrpop/src/expression_logos.lalrpop
use crate::ast::{Expr,Kind,Binding,Program,Declaration,TypeSyntax,Associativity,Pat,PatKind,Row,RowBody,DataDecl,ConstructorDecl};
use crate::source::{FileId,Span};
use crate::diagnostics::Diagnostic;
use crate::lexer::Token;
grammar(file:FileId);
pub Program:Program = <l:@L> "{" <decls:Declarations> "}" <r:@R> =>? crate::parse::program(decls,Span::new(file,l,r)).map_err(|error|lalrpop_util::ParseError::User {error});
Bindings:Vec<Binding> = <decls:Declarations> =>? crate::parse::declarations(decls).map_err(|error|lalrpop_util::ParseError::User {error});
Declarations:Vec<Declaration> = { => vec![], <b:Declaration> <tail:(";" <Declaration>)*> ";"? => {let mut out=vec![b];out.extend(tail);out} };
Declaration:Declaration = {
    <l:@L> "class" <head:QualType> <members:("where" "{" <Declarations> "}")?> <r:@R> =>? crate::parse::class(head,members.unwrap_or_default(),Span::new(file,l,r)).map(Declaration::Class).map_err(|error|lalrpop_util::ParseError::User {error}),
    <l:@L> "instance" <head:QualType> <methods:("where" "{" <Bindings> "}")?> <r:@R> =>? crate::parse::instance(head,methods.unwrap_or_default(),Span::new(file,l,r)).map(Declaration::Instance).map_err(|error|lalrpop_util::ParseError::User {error}),
    <l:@L> "type" <name:"constructor"> <parameters:"identifier"*> "=" <body:Type> <r:@R>=>Declaration::Alias(crate::ast::TypeAlias {name,parameters,body,span:Span::new(file,l,r)}),
    <l:@L> "data" <name:DataName> <parameters:"identifier"*> "=" <first:Constructor> <rest:("|" <Constructor>)*> <deriving:("deriving" <Deriving>)?> <r:@R> => {let mut constructors=vec![first];constructors.extend(rest);Declaration::Data(DataDecl {name,parameters,constructors,deriving:deriving.unwrap_or_default(),span:Span::new(file,l,r)})},
    <l:@L> <assoc:Assoc> <prec:"integer"> <first:Operator> <rest:("," <Operator>)*> <r:@R> =>? {let mut ops=vec![first];ops.extend(rest);crate::parse::fixity(assoc,prec,ops,Span::new(file,l,r)).map(Declaration::Fixity).map_err(|error|lalrpop_util::ParseError::User {error})},
    <b:Binding> => b,
    <l:@L> <first:Variable> <rest:("," <Variable>)*> "::" <ty:QualType> <r:@R> => {let mut names=vec![first];names.extend(rest);Declaration::Signature(names,ty,Span::new(file,l,r))},
};
Deriving:Vec<String> = { <n:"constructor">=>vec![n], "(" <first:"constructor"> <rest:("," <"constructor">)*> ")"=>{let mut ns=vec![first];ns.extend(rest);ns} };
DataName:String = { "constructor", "[" "]" => "[]".into(), "(" ")" => "()".into(), "(" "," ")" => "(,)".into(), "(" "," "," ")" => "(,,)".into() };
ConWord:String = {"constructor","True"=>"True".into(),"False"=>"False".into()};
ConName:String = { ConWord, "[" "]" => "[]".into(), "(" ")" => "()".into(), "(" "," ")" => "(,)".into(), "(" "," "," ")" => "(,,)".into(), "(" ":" ")" => ":".into() };
Constructor:ConstructorDecl = {
    <l:@L> <name:ConName> <fields:TypeAtom*> <r:@R> => ConstructorDecl {name,fields,labels:None,span:Span::new(file,l,r)},
    <l:@L> <name:ConName> "{" <first:FieldDecl> <rest:("," <FieldDecl>)*> "}" <r:@R> => {let mut entries=first;entries.extend(rest.into_iter().flatten());let (labels,fields)=entries.into_iter().unzip();ConstructorDecl {name,fields,labels:Some(labels),span:Span::new(file,l,r)}},
};
FieldDecl:Vec<(String,TypeSyntax)> = <first:"identifier"> <rest:("," <"identifier">)*> "::" <ty:Type> => {let mut names=vec![first];names.extend(rest);names.into_iter().map(|n|(n,ty.clone())).collect()};
QualType:TypeSyntax = { <l:@L> <a:Type> "=>" <b:Type> <r:@R> =>? crate::parse::qualified(a,b,Span::new(file,l,r)).map_err(|error|lalrpop_util::ParseError::User {error}), Type };
Type:TypeSyntax = { <a:TypeApply> "->" <b:Type> => TypeSyntax::Arrow(Box::new(a),Box::new(b)), TypeApply };
TypeApply:TypeSyntax = {<a:TypeApply> <b:TypeAtom>=>TypeSyntax::App(Box::new(a),Box::new(b)),TypeAtom};
TypeAtom:TypeSyntax = {
    "[" "]"=>TypeSyntax::Name("[]".into()),
    "(" "->" ")"=>TypeSyntax::Name("(->)".into()),
    "(" "," ")"=>TypeSyntax::Name("(,)".into()),
    "(" "," "," ")"=>TypeSyntax::Name("(,,)".into()),
    <n:"identifier"> => TypeSyntax::Name(n), <n:"constructor"> => TypeSyntax::Name(n), "(" <Type> ")",
    "[" <a:Type> "]" => TypeSyntax::App(Box::new(TypeSyntax::Name("[]".into())),Box::new(a)),
    "(" ")" => TypeSyntax::Name("()".into()),
    "(" <a:Type> "," <b:Type> <rest:("," <Type>)*> ")" => {let mut ts=vec![a,b];ts.extend(rest);let n=ts.len();ts.into_iter().fold(TypeSyntax::Name(format!("({})",",".repeat(n-1))),|a,b|TypeSyntax::App(Box::new(a),Box::new(b)))},
};
Binding:Declaration = {
    <l:@L> <head:APat> <patterns:APat*> <body:BindBody> <locals:Where> <r:@R> =>? crate::parse::lhs(head,patterns,body,locals,Span::new(file,l,r)).map_err(|error|lalrpop_util::ParseError::User {error}),
    <l:@L> "(" <name:Operator> ")" <patterns:APat*> <body:BindBody> <locals:Where> <r:@R> => Declaration::Binding(crate::parse::equation(file,l,r,name,patterns,body,locals)),
    <l:@L> <a:APat> <op:Operator> <b:APat> <body:BindBody> <locals:Where> <r:@R> => if op==":" {Declaration::Pattern(Pat {kind:PatKind::Con(op,vec![a,b]),span:Span::new(file,l,r)},body,locals,Span::new(file,l,r))} else {Declaration::Binding(crate::parse::equation(file,l,r,op,vec![a,b],body,locals))},
};
Where:Vec<Binding> = { => vec![], "where" "{" <Bindings> "}" };
BindBody:RowBody = { "=" <e:Expr>=>RowBody::Plain(Box::new(e)), <gs:("|" <Expr> "=" <Expr>)+>=>RowBody::Guarded(gs) };
AltBody:RowBody = { "->" <e:Expr>=>RowBody::Plain(Box::new(e)), <gs:("|" <GuardExpr> "->" <Expr>)+>=>RowBody::Guarded(gs) };
Alt:Row = <l:@L> <p:Pattern> <body:AltBody> <locals:Where> <r:@R> => Row {patterns:vec![p],body,locals,span:Span::new(file,l,r)};
Alternatives:Vec<Row> = <a:Alt> <rest:(";" <Alt>)*> ";"? => {let mut rows=vec![a];rows.extend(rest);rows};
Pattern:Pat = {<a:LPat> ":" <b:Pattern>=>{let span=a.span.through(b.span);Pat {kind:PatKind::Con(":".into(),vec![a,b]),span}},LPat};
LPat:Pat = {
    <l:@L> <name:ConWord> <ps:APat+> <r:@R>=>Pat {kind:PatKind::Con(name,ps),span:Span::new(file,l,r)},
    <l:@L> "-" <n:"integer"> <r:@R>=>Pat {kind:PatKind::Int((n.wrapping_neg()<<1)>>1),span:Span::new(file,l,r)}, APat
};
APat:Pat = {
    <l:@L> <n:"double"> <r:@R>=>Pat {kind:PatKind::Double(n),span:Span::new(file,l,r)},
    <l:@L> <n:ConWord> "{" <fields:Comma<FieldPat>> "}" <r:@R>=>Pat {kind:PatKind::Record(n,fields),span:Span::new(file,l,r)},
    <l:@L> <n:"identifier"> <rest:("@" <APat>)?> <r:@R> => Pat {kind:match rest {Some(p)=>PatKind::As(n,Box::new(p)),None if n=="_"=>PatKind::Wild,None=>PatKind::Var(n)},span:Span::new(file,l,r)},
    <l:@L> <name:ConWord> <r:@R>=>Pat {kind:PatKind::Con(name,vec![]),span:Span::new(file,l,r)},
    <l:@L> <n:"integer"> <r:@R>=>Pat {kind:PatKind::Int(n),span:Span::new(file,l,r)},
    <l:@L> <n:"char"> <r:@R>=>Pat {kind:PatKind::Char(n),span:Span::new(file,l,r)},
    <l:@L> <n:"string"> <r:@R>=>Pat {kind:PatKind::String(n),span:Span::new(file,l,r)},
    <l:@L> "(" <mut p:Pattern> ")" <r:@R>=>{p.span=Span::new(file,l,r);p},
    <l:@L> "[" <ps:Comma<Pattern>> "]" <r:@R>=>Pat {kind:PatKind::List(ps),span:Span::new(file,l,r)},
    <l:@L> "(" ")" <r:@R>=>Pat {kind:PatKind::Tuple(vec![]),span:Span::new(file,l,r)},
    <l:@L> "(" <a:Pattern> "," <b:Pattern> <rest:("," <Pattern>)*> ")" <r:@R>=>{let mut ps=vec![a,b];ps.extend(rest);Pat {kind:PatKind::Tuple(ps),span:Span::new(file,l,r)}},
};
FieldPat:(String,Pat)=<n:"identifier"> "=" <p:Pattern> => (n,p);
FieldBind:(String,Expr)=<n:"identifier"> "=" <e:Expr> => (n,e);
Comma<T>:Vec<T> = {=>vec![],<first:T> <rest:("," <T>)*>=>{let mut items=vec![first];items.extend(rest);items}};
pub Expr:Expr = { Special, <l:@L> <a:Unary> <tail:ExprTail> <r:@R>=>{let e=Expr::new(Kind::Chain(Box::new(a),tail.0,tail.1),file,l,r);match tail.2{Some(t)=>Expr::new(Kind::Annotated(Box::new(e),t),file,l,r),None=>e}} };
ExprTail:(Vec<(String,Expr)>,Option<String>,Option<TypeSyntax>) = {
    => (vec![],None,None),
    "::" <t:QualType> => (vec![],None,Some(t)),
    <op:Operator> <a:Special> => (vec![(op,a)],None,None),
    <op:Operator> <rest:(<Unary> <ExprTail>)?> => match rest {Some((rhs,(mut pairs,last,ty)))=>{pairs.insert(0,(op,rhs));(pairs,last,ty)},None=>(vec![],Some(op),None)},
};
Special:Expr = {
    <l:@L> "do" "{" <statements:DoStatements> "}" <r:@R> =>? crate::desugar::do_block(statements,Span::new(file,l,r)).map_err(|error|lalrpop_util::ParseError::User {error}),
    <l:@L> "case" <scrut:Expr> "of" "{" <rows:Alternatives> "}" <r:@R> => Expr::new(Kind::Case(Box::new(scrut),rows),file,l,r),
    <l:@L> "let" "{" <bindings:Bindings> "}" "in" <body:Expr> <r:@R> => {let mut e=crate::parse::local(bindings,body);e.span=Span::new(file,l,r);e},
    <l:@L> "\\" <params:APat+> "->" <body:Expr> <r:@R> => Expr::new(Kind::PatternLam(params,Box::new(body)),file,l,r),
    <l:@L> "if" <c:Expr> "then" <a:Expr> "else" <b:Expr> <r:@R> => Expr::new(Kind::If(Box::new(c),Box::new(a),Box::new(b)),file,l,r),
};
DoStatements:Vec<crate::desugar::Statement> = <first:DoStatement> <rest:(";" <DoStatement>)*> ";"? => {let mut out=vec![first];out.extend(rest);out};
DoStatement:crate::desugar::Statement = {
    "let" "{" <bindings:Bindings> "}" => crate::desugar::Statement::Let(bindings),
    <e:Expr> <binding:("<-" <Expr>)?> =>? match binding {Some(rhs)=>crate::desugar::do_pattern(e).map(|p|crate::desugar::Statement::Bind(p,rhs)).map_err(|error|lalrpop_util::ParseError::User {error}),None=>Ok(crate::desugar::Statement::Expr(e))},
};
Assoc:Associativity = {"infixl" => Associativity::Left, "infixr" => Associativity::Right, "infix" => Associativity::None};
Variable:String = { "identifier", "(" <Operator> ")" };
Operator:String = { "-" => "-".into(), NonMinusOperator };
NonMinusOperator:String = { ":" => ":".into(), "+" => "+".into(), "*" => "*".into(), "++" => "++".into(), "==" => "==".into(), "<" => "<".into(), "<=" => "<=".into(), "operator", "`" <"identifier"> "`" };
GuardExpr:Expr = { GuardSpecial, <l:@L> <a:Unary> <tail:GuardTail> <r:@R> => Expr::new(Kind::Chain(Box::new(a),tail.0,tail.1),file,l,r) };
GuardTail:(Vec<(String,Expr)>,Option<String>) = {
    => (vec![],None),
    <op:Operator> <a:GuardSpecial> => (vec![(op,a)],None),
    <op:Operator> <rest:(<Unary> <GuardTail>)?> => match rest {Some((rhs,(mut pairs,last)))=>{pairs.insert(0,(op,rhs));(pairs,last)},None=>(vec![],Some(op))},
};
GuardSpecial:Expr = {
    <l:@L> "do" "{" <statements:DoStatements> "}" <r:@R> =>? crate::desugar::do_block(statements,Span::new(file,l,r)).map_err(|error|lalrpop_util::ParseError::User {error}),
    <l:@L> "case" <scrut:Expr> "of" "{" <rows:Alternatives> "}" <r:@R> => Expr::new(Kind::Case(Box::new(scrut),rows),file,l,r),
    <l:@L> "let" "{" <bindings:Bindings> "}" "in" <body:GuardExpr> <r:@R> => {let mut e=crate::parse::local(bindings,body);e.span=Span::new(file,l,r);e},
    <l:@L> "\\" <params:APat+> "->" <body:GuardExpr> <r:@R> => Expr::new(Kind::PatternLam(params,Box::new(body)),file,l,r),
    <l:@L> "if" <c:Expr> "then" <a:Expr> "else" <b:GuardExpr> <r:@R> => Expr::new(Kind::If(Box::new(c),Box::new(a),Box::new(b)),file,l,r),
};
Unary:Expr = {<l:@L> "-" <a:Unary> <r:@R>=>Expr::new(Kind::Neg(Box::new(a)),file,l,r),Application};
Application:Expr = {
    <a:Application> <b:Postfix>=>{let (l,r)=(a.span.start as usize,b.span.end as usize);Expr::new(Kind::App(Box::new(a),Box::new(b)),file,l,r)},Postfix
};
Postfix:Expr = {
    <a:Postfix> "projection" <n:"identifier"> <r:@R> => {let l=a.span.start as usize;Expr::new(Kind::Project(Box::new(a),n),file,l,r)},
    <a:Postfix> "{" <first:FieldBind> <rest:("," <FieldBind>)*> "}" <r:@R> => {let l=a.span.start as usize;let mut fields=vec![first];fields.extend(rest);let kind=if let Kind::Var(n)=&a.kind {if n.starts_with(char::is_uppercase) {Kind::Record(n.clone(),fields)} else {Kind::Update(Box::new(a),fields)}} else {Kind::Update(Box::new(a),fields)};Expr::new(kind,file,l,r)},
    Atom
};
Atom:Expr = {
    <l:@L> "[" <a:Expr> ".." <b:Expr> "]" <r:@R> => crate::desugar::range(a,b,Span::new(file,l,r)),
    <l:@L> <n:"identifier"> "@" <p:Atom> <r:@R> => Expr::new(Kind::PatternAs(n,Box::new(p)),file,l,r),
    <l:@L> <n:"double"> <r:@R>=>Expr::new(Kind::Double(n),file,l,r),
    <l:@L> "(" "projection section" <n:"identifier"> ")" <r:@R>=>Expr::new(Kind::ProjectionSection(n),file,l,r),
    <l:@L> "[" <es:Comma<Expr>> "]" <r:@R>=>Expr::new(Kind::List(es),file,l,r),
    <l:@L> "(" ")" <r:@R>=>Expr::new(Kind::Tuple(vec![]),file,l,r),
    <l:@L> "(" <a:Expr> "," <b:Expr> <rest:("," <Expr>)*> ")" <r:@R>=>{let mut es=vec![a,b];es.extend(rest);Expr::new(Kind::Tuple(es),file,l,r)},
    <l:@L> "(" "," ")" <r:@R>=>Expr::new(Kind::Var("(,)".into()),file,l,r),
    <l:@L> "(" "," "," ")" <r:@R>=>Expr::new(Kind::Var("(,,)".into()),file,l,r),
    <l:@L> <n:"integer"> <r:@R>=>Expr::new(Kind::Int(n),file,l,r),
    <l:@L> <n:"string"> <r:@R>=>Expr::new(Kind::String(n),file,l,r),
    <l:@L> <n:"char"> <r:@R>=>Expr::new(Kind::Char(n),file,l,r),
    <l:@L> <n:"identifier"> <r:@R>=>Expr::new(Kind::Var(n),file,l,r),
    <l:@L> <n:"constructor"> <r:@R>=>Expr::new(Kind::Var(n),file,l,r),
    <l:@L> "True" <r:@R>=>Expr::new(Kind::Var("True".into()),file,l,r),
    <l:@L> "False" <r:@R>=>Expr::new(Kind::Var("False".into()),file,l,r),
    <l:@L> "(" <a:Expr> ")" <r:@R> => Expr::new(Kind::Paren(Box::new(a)),file,l,r),
    <l:@L> "(" <op:Operator> ")" <r:@R> => Expr::new(Kind::Var(op),file,l,r),
    <l:@L> "(" <op:NonMinusOperator> <a:Expr> ")" <r:@R> => Expr::new(Kind::RightSection(op,Box::new(a)),file,l,r),
};
extern {
 type Location=usize;type Error=Diagnostic;
 enum Token {
 "deriving"=>Token::Deriving,".."=>Token::Range,
 "do"=>Token::Do,"<-"=>Token::BindArrow,
 "class"=>Token::Class,"instance"=>Token::Instance,"=>"=>Token::Constraint,
 "type"=>Token::Type,
 "projection"=>Token::Proj,"projection section"=>Token::ProjSection,
 "data"=>Token::Data,"case"=>Token::Case,"of"=>Token::Of,":"=>Token::Colon,"|"=>Token::Bar,"@"=>Token::At,"["=>Token::BracketOpen,"]"=>Token::BracketClose,
 "infix"=>Token::Infix,"infixl"=>Token::Infixl,"infixr"=>Token::Infixr,"`"=>Token::Backtick,"operator"=>Token::Operator(<String>),"::"=>Token::ColonColon,","=>Token::Comma,"where"=>Token::Where,"let"=>Token::Let,"in"=>Token::In,"if"=>Token::If,"then"=>Token::Then,"else"=>Token::Else,
 "\\"=>Token::Lambda,"->"=>Token::Arrow,"True"=>Token::True,"False"=>Token::False,
 "+"=>Token::Plus,"-"=>Token::Minus,"*"=>Token::Star,"++"=>Token::Append,
 "=="=>Token::Eq,"<"=>Token::Lt,"<="=>Token::Le,"="=>Token::Equals,
 "("=>Token::Left,")"=>Token::Right,"{"=>Token::Open,"}"=>Token::Close,";"=>Token::Semi,
 "double"=>Token::Double(<u64>),"integer"=>Token::Int(<i64>),"string"=>Token::String(<String>),"char"=>Token::Char(<char>),
 "identifier"=>Token::Ident(<String>),"constructor"=>Token::Constructor(<String>),
 }
}
